{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diffusion IDE",
  "version": "0.8.0-alpha.7",
  "identifier": "io.diffusion.ide",
  "build": {
    "frontendDist": "../../web",
    "beforeBuildCommand": "pnpm --filter @diffusion/editor-cm6 build",
    "beforeDevCommand": "pnpm --filter @diffusion/editor-cm6 build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Diffusion IDE",
        "width": 1360,
        "height": 850,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
