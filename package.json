{
  "name": "diffusion-ide",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "Koide：本地优先的跨平台 AI IDE，原生应用由 Rust Native Core 驱动。",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "start": "pnpm build:cm6 && python3 bridge/main.py --open",
    "build": "pnpm -r --if-present run build",
    "build:cm6": "pnpm --filter @diffusion/editor-cm6 run build",
    "watch:cm6": "pnpm --filter @diffusion/editor-cm6 run watch",
    "test": "pnpm build:cm6 && pnpm test:bridge && pnpm test:web && node scripts/check-native-parity.mjs",
    "test:web": "node --test tests/web/*.test.mjs",
    "test:bridge": "python3 -m unittest discover -s tests/bridge -v",
    "test:browser": "playwright test --config tests/browser/playwright.config.mjs",
    "native:dev": "pnpm --filter @diffusion/native dev",
    "native:build": "pnpm --filter @diffusion/native build",
    "android:build": "pnpm --filter @diffusion/native android:build"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^5.9.3"
  }
}
